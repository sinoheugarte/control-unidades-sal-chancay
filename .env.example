# Puerto HTTP
PORT=3000
# Ruta del archivo SQLite
DB_PATH=./data/control.db
# Usuario administrador inicial (sólo se usa si la base está vacía)
ADMIN_USER=admin
ADMIN_PASSWORD=cambie-esta-clave
# Duración de la sesión en horas
SESSION_HOURS=12
# Poner 1 cuando se sirva por HTTPS (cookie Secure)
COOKIE_SECURE=0
